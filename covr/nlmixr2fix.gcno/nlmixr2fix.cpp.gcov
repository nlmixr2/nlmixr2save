        -:    1:#include <Rcpp.h>
        -:    2:
        -:    3://' Fix nlmixr2 save output
        -:    4://'
        -:    5://' This function modifies the output of nlmixr2's save function to ensure that
        -:    6://' the numeric columns of the `parFixedDf` data frame have the types that
        -:    7://' nlmixr2 outputs after a CSV round-trip (all-`NA` columns are read back as
        -:    8://' logical vectors, so they are coerced back to numeric here).
        -:    9://'
        -:   10://' Depending on the version of nlmixr2est that created the fit, the
        -:   11://' "Estimate" and "SE" columns are either named numeric vectors (names
        -:   12://' matching the row names; nlmixr2est <= 6.0) or plain unnamed numeric
        -:   13://' vectors (the `$parFixed` refactor in newer nlmixr2est).  The `named`
        -:   14://' argument selects which structure is restored; `nlmixr2save::saveFit()`
        -:   15://' records the correct value in the generated restore script based on the
        -:   16://' fit being saved.
        -:   17://'
        -:   18://' @param obj A list object returned by nlmixr2's save function.
        -:   19://'
        -:   20://' @param named Logical; when `TRUE` (default, matching fits from older
        -:   21://'   nlmixr2est) the "Estimate" and "SE" columns are named using the row
        -:   22://'   names; when `FALSE` they are left as unnamed numeric vectors.
        -:   23://'
        -:   24://' @return A modified data.frame object with numeric columns restored to
        -:   25://'   the structure of the original fit
        -:   26://'
        -:   27://' @keywords internal
        -:   28://'
        -:   29://' @export
        -:   30://'
        -:   31:// [[Rcpp::export]]
      162:   32:SEXP nlmixr2saveParFixedDf(SEXP obj, bool named = true) {
        -:   33:  // This makes the data.frame types match what nlmixr2 outputs
      162:   34:  Rcpp::List ret = Rcpp::as<Rcpp::List>(obj);
      162:   35:  Rcpp::NumericVector nv;
      162:   36:  const char *nameCols[] = {"Estimate", "SE"};
      486:   37:  for (int i = 0; i < 2; i++) {
      324:   38:    if (ret.containsElementNamed(nameCols[i])) {
      324:   39:      nv = Rcpp::as<Rcpp::NumericVector>(ret[nameCols[i]]);
      324:   40:      if (named) {
      312:   41:        Rf_setAttrib(nv, R_NamesSymbol, Rf_getAttrib(obj, R_RowNamesSymbol));
        -:   42:      } else {
       12:   43:        Rf_setAttrib(nv, R_NamesSymbol, R_NilValue);
        -:   44:      }
      648:   45:      ret[nameCols[i]] = nv;
        -:   46:    }
        -:   47:  }
      162:   48:  const char *numCols[] = {"%RSE", "Back-transformed", "CI Lower", "CI Upper",
        -:   49:                           "BSV(SD)", "BSV(CV%)", "BSV(CV% or SD)",
        -:   50:                           "Shrink(SD)%"};
     1458:   51:  for (int i = 0; i < 8; i++) {
     1296:   52:    if (ret.containsElementNamed(numCols[i])) {
     1896:   53:      nv = Rcpp::as<Rcpp::NumericVector>(ret[numCols[i]]);
     1896:   54:      ret[numCols[i]] = nv;
        -:   55:    }
        -:   56:  }
      162:   57:  Rf_setAttrib(ret, R_RowNamesSymbol, Rf_getAttrib(obj, R_RowNamesSymbol));
      162:   58:  ret.attr("class") = "data.frame";
      324:   59:  return Rcpp::wrap(ret);
      162:   60:}
